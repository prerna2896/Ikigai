# Copy to .env.local and fill in.
#
# Local Supabase (via `supabase start`) prints these values to stdout;
# also visible via `supabase status`. Values are identical for every
# developer running local Supabase — they're not secrets in that mode.
#
# For a hosted Supabase project (staging/prod), replace with the values
# from Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service-role key: server-side only. NEVER inline into a client bundle.
# Used by:
#   - supabase/scripts/run-pgtap.sh (creates throwaway test users)
#   - tests/rls/isolation.spec.ts (same)
#   - future admin-only Route Handlers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Direct Postgres connection — used by drizzle-kit for migrations and by
# supabase/scripts/audit-rls.sh + run-pgtap.sh for direct psql access.
# Session mode (port 54322 locally); production would use Supavisor
# transaction pooler on 6543 for the runtime app and session mode 5432
# for migrations only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
